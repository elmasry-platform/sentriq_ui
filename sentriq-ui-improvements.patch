+/* SENTRIQ UI polish layer — loaded after sentriq.css.
+   Accessibility (focus, skip link, targets), the account menu, shared states,
+   and the inspection / action screens. Keep fonts >= 12px and text contrast >= 4.5:1. */
+
+:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible { outline: 2px solid var(--accent-fill); outline-offset: 2px; }
+.skip-link { position: fixed; inset-block-start: 8px; inset-inline-start: 8px; z-index: 400; padding: 10px 14px; border-radius: 5px; background: var(--navy); color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; transform: translateY(-220%); }
+.skip-link:focus { transform: none; }
+.main-content:focus { outline: none; }
+
+/* ---------- off-canvas drawer: nothing focusable or visible while closed ---------- */
+@media (max-width: 720px) {
+  .sidebar:not(.sidebar-mobile-open) { visibility: hidden; box-shadow: none; transition: transform .2s ease, visibility 0s linear .2s; }
+  .sidebar.sidebar-mobile-open { visibility: visible; transition: transform .2s ease; }
+}
+
+/* ---------- account menu (phones and tablets) ---------- */
+.avatar-menu { display: none; position: relative; }
+.avatar-menu-trigger { width: 34px; height: 34px; padding: 0; cursor: pointer; font: inherit; font-size: 12px; font-weight: 700; }
+.avatar-menu-panel { position: absolute; inset-block-start: calc(100% + 8px); inset-inline-end: 0; z-index: 80; width: min(310px, calc(100vw - 24px)); display: grid; gap: 14px; padding: 16px; border: 1px solid var(--border); background: var(--surface); box-shadow: 0 16px 38px rgba(25, 38, 45, .18); }
+.avatar-menu-head { display: flex; align-items: center; gap: 11px; }
+.avatar-menu-head strong { display: block; font-size: 14px; }
+.avatar-menu-head small, .avatar-menu-note { color: var(--muted-strong); font-size: 12px; line-height: 1.5; }
+.avatar-menu-note { margin: -6px 0 0; }
+.avatar-menu-field { display: grid; gap: 6px; font-size: 12px; font-weight: 600; color: var(--muted-strong); }
+.avatar-menu-field select { min-height: 40px; padding: 0 10px; border: 1px solid var(--border); background: #fff; color: var(--text); font: inherit; font-size: 13px; }
+.avatar-menu-lang { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
+.avatar-menu-lang button { min-height: 40px; border: 1px solid var(--border); background: #fff; color: var(--text); font: inherit; font-size: 13px; cursor: pointer; }
+.avatar-menu-lang button[aria-pressed="true"] { border-color: var(--navy); background: var(--navy); color: #fff; font-weight: 600; }
+@media (max-width: 900px) {
+  .avatar-menu { display: block; }
+  .topbar-actions > .avatar, .topbar-actions > .role-picker, .topbar-actions > .language-button, .topbar-actions > .profile-divider { display: none; }
+}
+
+/* ---------- shared bits ---------- */
+.ux-muted { color: var(--muted-strong); }
+.ux-link { padding: 0; border: 0; background: none; color: var(--teal); font: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
+.ux-count { margin-inline-start: 6px; padding: 1px 7px; border-radius: 10px; background: #EAE7DF; color: var(--muted-strong); font-size: 12px; font-weight: 600; }
+.ux-body { margin: 0; color: #3C4844; font-size: 14px; line-height: 1.6; }
+.ux-small { min-height: 32px; padding: 5px 10px; }
+.inspection-page .eyebrow, .inspection-runner .eyebrow { margin: 0 0 6px; color: var(--teal); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
+.ux-dialog-hint { margin: -4px 0 0; color: var(--muted-strong); font-size: 12px; line-height: 1.5; }
+
+/* status + priority chips: icon + text, never color alone */
+.ux-badge { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 3px 9px; border-radius: 4px; background: #EAE7DF; color: #3A4642; font-size: 12px; font-weight: 600; white-space: nowrap; }
+.ux-badge-approved, .ux-badge-closed { background: #E1EBE6; color: #2B5248; }
+.ux-badge-returned, .ux-badge-overdue { background: #F6E4E1; color: #8A2F29; }
+.ux-badge-in-review, .ux-badge-submitted, .ux-badge-closure-requested { background: #F3EBDD; color: #6A4D12; }
+.ux-badge-in-progress { background: #E4EBEF; color: #2A4A58; }
+.ux-priority { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: #3A4642; }
+.ux-priority i { width: 9px; height: 9px; border-radius: 50%; background: #8B918D; }
+.ux-priority-medium i { background: #C39A4B; } .ux-priority-high i { background: #D46A43; } .ux-priority-critical i { background: #B84E48; box-shadow: 0 0 0 2px #F6E4E1; }
+
+/* states */
+.ux-state { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 46px 20px; text-align: center; color: var(--muted-strong); }
+.ux-state h2 { margin: 0; color: var(--text); font-size: 17px; }
+.ux-state p { max-width: 460px; margin: 0; font-size: 13px; line-height: 1.6; }
+.ux-state-icon { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: #EAE7DF; color: var(--muted-strong); }
+.ux-state-error .ux-state-icon { background: #F6E4E1; color: #8A2F29; }
+.ux-state-locked .ux-state-icon { background: #E4EBEF; color: #2A4A58; }
+.ux-loading { display: grid; gap: 12px; margin-top: 20px; }
+.ux-loading span { display: block; height: 52px; background: linear-gradient(90deg, #E9E6DE, #F6F4EF, #E9E6DE); background-size: 200% 100%; animation: ux-shimmer 1.4s linear infinite; }
+@keyframes ux-shimmer { to { background-position: -200% 0; } }
+@media (prefers-reduced-motion: reduce) { .ux-loading span { animation: none; } }
+
+/* ---------- list ---------- */
+.ux-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 18px 0 4px; }
+.ux-summary-card { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 14px 16px; border: 1px solid var(--border); border-inline-start: 3px solid #B9B6AC; background: var(--surface); color: var(--text); font: inherit; text-align: start; cursor: pointer; }
+.ux-summary-card strong { font-size: 28px; font-weight: 600; letter-spacing: -.03em; line-height: 1; }
+.ux-summary-card span { color: var(--muted-strong); font-size: 12px; font-weight: 600; }
+.ux-summary-card:hover { background: #F7F5EF; }
+.ux-summary-card.is-active { border-color: var(--navy); border-inline-start-width: 3px; background: #fff; box-shadow: 0 0 0 1px var(--navy) inset; }
+.ux-summary-review { border-inline-start-color: #C39A4B; } .ux-summary-returned { border-inline-start-color: #B84E48; } .ux-summary-overdue { border-inline-start-color: #D46A43; } .ux-summary-mine { border-inline-start-color: var(--teal); }
+.ux-cell-sub { display: flex; align-items: center; gap: 5px; margin-top: 3px; color: var(--muted-strong); font-size: 12px; }
+.ux-stage { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
+.ux-stage-dots { display: inline-flex; gap: 4px; }
+.ux-stage-dots i { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid #8B918D; }
+.ux-stage-dots i.done { background: var(--teal); border-color: var(--teal); } .ux-stage-dots i.current { background: var(--navy); border-color: var(--navy); }
+.ux-stage-done { color: #2B5248; font-weight: 600; }
+.ux-due.is-overdue { color: #A33B35; font-weight: 600; }
+.inspection-filter-tabs button { display: inline-flex; align-items: center; }
+
+/* ---------- detail ---------- */
+.inspection-meta.is-danger { border-color: #D9A7A3; }
+.ux-overdue-note { color: #A33B35; font-size: 12px; font-style: normal; font-weight: 600; }
+.ux-stepper { display: flex; flex-wrap: wrap; gap: 8px 0; margin: 20px 0; padding: 0; list-style: none; }
+.ux-step { display: flex; align-items: center; gap: 9px; padding-inline-end: 34px; position: relative; color: var(--muted-strong); font-size: 13px; }
+.ux-step:not(:last-child)::after { content: ""; position: absolute; inset-inline-end: 8px; inset-block-start: 50%; width: 18px; height: 2px; background: #CFCBC0; }
+.ux-step-dot { width: 28px; height: 28px; display: grid; place-items: center; border: 2px solid #CFCBC0; border-radius: 50%; background: #fff; font-size: 12px; font-weight: 700; }
+.ux-step-done .ux-step-dot { border-color: var(--teal); background: var(--teal); color: #fff; }
+.ux-step-done .ux-step-label { color: var(--text); }
+.ux-step-current .ux-step-dot { border-color: var(--navy); background: var(--navy); color: #fff; }
+.ux-step-current .ux-step-label { color: var(--navy); font-weight: 700; }
+.ux-overview-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 18px 0; }
+.ux-overview-stats div { padding: 12px 14px; border: 1px solid var(--border); background: var(--page); }
+.ux-overview-stats dt { color: var(--muted-strong); font-size: 12px; font-weight: 600; }
+.ux-overview-stats dd { margin: 5px 0 0; font-size: 18px; font-weight: 600; }
+.ux-waiting { display: flex; align-items: center; gap: 9px; margin: 16px 0 0; padding: 11px 13px; background: #F3EBDD; color: #5A4010; font-size: 13px; }
+.ux-review-heading { margin: 0; font-size: 14px; }
+.ux-review-buttons { display: flex; flex-wrap: wrap; gap: 10px; }
+.ux-finding { flex-direction: column; align-items: stretch; }
+.ux-finding-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.ux-finding-head > div { display: flex; flex-direction: column; gap: 5px; }
+.ux-finding-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 10px; font-size: 13px; }
+.ux-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.ux-links { display: grid; gap: 9px; margin: 0 0 12px; padding: 0; list-style: none; }
+.ux-links li { display: flex; align-items: center; gap: 9px; font-size: 13px; }
+.ux-links li > span { color: var(--muted-strong); min-width: 84px; }
+.ux-sub { margin-top: 20px !important; font-size: 15px !important; }
+.ux-action-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
+.ux-attach { display: inline-flex; margin-top: 10px; }
+
+/* ---------- runner ---------- */
+.inspection-runner { padding-bottom: 0; }
+.ux-section-nav { display: flex; gap: 6px; margin-top: 14px; padding-bottom: 2px; overflow-x: auto; }
+.ux-section-nav button { min-height: 38px; display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font: inherit; font-size: 12px; white-space: nowrap; cursor: pointer; }
+.ux-section-nav button.is-complete { border-color: var(--teal); color: #2B5248; }
+.ux-section-nav button.is-active { border-color: var(--navy); background: var(--navy); color: #fff; font-weight: 600; }
+.runner-question-title { display: flex; align-items: flex-start; gap: 10px; }
+.runner-question-title label { flex: 1; min-width: 0; font-weight: 600; line-height: 1.45; }
+.ux-qnum { color: var(--muted-strong); font-size: 12px; font-weight: 700; padding-top: 2px; }
+.ux-help { margin: 8px 0 0; color: var(--muted-strong); font-size: 12px; line-height: 1.5; }
+.runner-raise { margin-inline-start: auto; min-height: 32px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border: 1px solid transparent; background: transparent; color: var(--muted-strong); font: inherit; font-size: 12px; white-space: nowrap; cursor: pointer; }
+.runner-raise:hover { border-color: var(--border); background: #fff; }
+.runner-raise.is-flagged { background: #F6E4E1; color: #8A2F29; font-weight: 600; }
+.runner-question.has-error { border-color: #D9A7A3; }
+.runner-error { display: flex; align-items: center; gap: 6px; margin-top: 10px; color: #A33B35; font-size: 12px; font-weight: 600; }
+.runner-question .runner-options { display: grid; gap: 8px; margin-top: 12px; }
+.runner-question .runner-option { width: 100%; min-height: 52px; display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--border); background: #fff; cursor: pointer; }
+.runner-question .runner-option input { accent-color: var(--teal); width: 20px; height: 20px; flex: none; }
+.runner-question .runner-option.selected { border-color: var(--teal); background: #EEF4F1; box-shadow: 0 0 0 1px var(--teal) inset; }
+.runner-question .runner-choice-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
+.runner-question .runner-choice-row button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--border); background: #fff; color: var(--text); font: inherit; font-size: 14px; cursor: pointer; }
+.runner-question .runner-choice-row button.selected { border-color: var(--teal); background: #EEF4F1; color: #2B5248; font-weight: 700; box-shadow: 0 0 0 1px var(--teal) inset; }
+.runner-footer { position: sticky; inset-block-end: 0; z-index: 30; display: flex; align-items: center; gap: 12px; margin-top: 22px; padding: 10px 0 calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); background: rgba(243, 241, 234, .97); }
+.ux-footer-buttons { display: flex; gap: 8px; margin-inline-start: auto; }
+.ux-save-state { color: var(--muted-strong); font-size: 12px; }
+.ux-save-dirty { color: #6A4D12; font-weight: 600; }
+.ux-review-summary { margin: 4px 0 0; color: var(--muted-strong); font-size: 13px; }
+.ux-review-section { margin-top: 20px; }
+.ux-review-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.ux-review-section h3 { margin: 0 0 4px; font-size: 15px; }
+.runner-errors ul { display: grid; gap: 8px; margin: 10px 0 0; padding: 0; list-style: none; }
+.runner-errors li { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 13px; }
+.runner-errors li button { padding: 0; border: 0; background: none; color: var(--teal); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; text-align: start; }
+.ux-submit-hint { min-height: 18px; margin: 12px 0 0; color: #A33B35; font-size: 12px; }
+.inspection-offline { display: flex; align-items: center; gap: 8px; }
+.ux-success { align-items: center; padding: 56px 16px; text-align: center; }
+.ux-success-mark { width: 64px; height: 64px; display: grid; place-items: center; margin: 0 auto 8px; border-radius: 50%; background: #E1EBE6; color: #2B5248; }
+.ux-success p { max-width: 420px; margin: 8px auto 0; color: var(--muted-strong); font-size: 14px; }
+.ux-success-stats { display: flex; justify-content: center; gap: 28px; margin: 22px 0; }
+.ux-success-stats dt { color: var(--muted-strong); font-size: 12px; font-weight: 600; }
+.ux-success-stats dd { margin: 4px 0 0; font-size: 20px; font-weight: 600; }
+.ux-success-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
+
+/* ---------- responsive ---------- */
+@media (max-width: 900px) { .ux-two-col { grid-template-columns: minmax(0, 1fr); } .ux-overview-stats { grid-template-columns: 1fr; } }
+@media (max-width: 720px) {
+  .ux-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .inspection-table-scroll { overflow: visible; border: 0; background: transparent; }
+  .inspection-table { min-width: 0; }
+  .inspection-table, .inspection-table tbody, .inspection-table tr, .inspection-table td { display: block; width: 100%; }
+  .inspection-table thead { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
+  .inspection-table tbody tr { margin: 0 0 10px; padding: 10px 12px; border: 1px solid var(--border); background: var(--surface); }
+  .inspection-table tbody td { display: grid; grid-template-columns: minmax(96px, .7fr) minmax(0, 1.3fr); align-items: start; gap: 10px; padding: 7px 0; border: 0; }
+  .inspection-table tbody td::before { content: attr(data-label); color: var(--muted-strong); font-size: 12px; font-weight: 600; }
+}
+@media (max-width: 560px) {
+  .runner-footer { flex-wrap: wrap; }
+  .ux-save-state { flex-basis: 100%; order: -1; }
+  .ux-footer-buttons { width: 100%; }
+  .ux-footer-buttons > * { flex: 1; justify-content: center; }
+  .ux-section-nav button:not(.is-active):not(.ux-section-review) span { display: none; }
+  .ux-success-stats { gap: 18px; }
+}
+@media (pointer: coarse) {
+  .runner-raise, .ux-section-nav button, .ux-small, .avatar-menu-trigger { min-height: 44px; }
+  .avatar-menu-trigger { min-width: 44px; }
+}
+
+/* ---------- target sizes (WCAG 2.2: >= 24px always, >= 32px by default, 44px on touch) ---------- */
+.workspace-select-wrap select, .role-picker select, .site-filter select, .status-filter select { min-height: 32px; }
+.top-search input, .forms-search input, .inspection-search input { min-height: 32px; }
+.panel-link, .workspace-launcher-heading a, .operations-heading a, .admin-panel-heading a, .my-work-queue-view, .table-footer a,
+.inspection-record-id, .inspection-record-title, .record-id { display: inline-flex; align-items: center; min-height: 32px; }
+.row-action { min-width: 32px; min-height: 32px; display: inline-grid; place-items: center; }
+.icon-button, .collapse-button, .module-switcher-trigger, .language-button { min-width: 32px; min-height: 32px; }
+@media (pointer: coarse) {
+  .workspace-select-wrap select, .role-picker select, .site-filter select, .status-filter select, .top-search input, .forms-search input, .inspection-search input,
+  .panel-link, .workspace-launcher-heading a, .operations-heading a, .admin-panel-heading a, .my-work-queue-view, .table-footer a,
+  .inspection-record-id, .inspection-record-title, .record-id, .row-action, .icon-button, .collapse-button, .module-switcher-trigger, .language-button { min-height: 44px; }
+  .row-action, .icon-button { min-width: 44px; }
+}
+
+/* ---------- final touches ---------- */
+.ux-overview-stats dt { text-transform: capitalize; }
+.inspection-review-actions .ux-review-heading, .inspection-review-actions .ux-review-heading strong { color: var(--text); }
+.runner-footer { background: var(--page); padding-inline: 16px; margin-inline: -16px; }
+
+/* ---------- phone cards for record tables (overrides the first pass above) ---------- */
+@media (max-width: 720px) {
+  .inspection-table tbody tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 14px; padding: 14px; }
+  .inspection-table tbody td { display: block; padding: 0; min-width: 0; }
+  .inspection-table tbody td::before { display: block; margin-bottom: 3px; }
+  .inspection-table tbody td.ux-c-id { grid-column: 1 / -1; order: -3; }
+  .inspection-table tbody td.ux-c-title { grid-column: 1 / -1; order: -2; }
+  .inspection-table tbody td.ux-c-status { grid-column: 1 / -1; order: -1; }
+  .inspection-table tbody td.ux-c-id::before, .inspection-table tbody td.ux-c-title::before, .inspection-table tbody td.ux-c-status::before { display: none; }
+  .inspection-table tbody td.ux-c-title { font-size: 15px; }
+}
